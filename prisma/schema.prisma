generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model Guild {
  id        String   @id
  createdAt DateTime @default(now())
  members   Member[]
}

model User {
  id                   String             @id
  createdAt            DateTime           @default(now())
  steamId              String?            @unique
  steamLinkToken       String?            @unique
  steamLinkRequestedAt DateTime?
  members              Member[]
  snapshots            PlaytimeSnapshot[]
}

model Member {
  guildId  String
  userId   String
  xp       Int       @default(0)
  lastXpAt DateTime?
  guild    Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([guildId, userId])
  @@index([guildId, xp])
}

model PlaytimeSnapshot {
  userId          String
  appId           Int
  date            DateTime @db.Date
  playtimeForever Int
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, appId, date])
  @@index([date])
}
